export INCEPTION_LABS_API_KEY=""
#    note: mercury-2 answers /v1/chat/completions; mercury-edit-2 answers /v1/fim/completions and /v1/edit/completions instead, so an OpenAI-shaped chat client cannot call it — point an autocomplete plugin at it, not a chat agent

# ── Pollinations.AI — no key needed · base: https://text.pollinations.ai/openai
#    note: anonymous works and needs no key. The optional token that raises the rate limit has no working signup — auth.pollinations.ai, the host the vendor's own APIDOCS still sends you to, stopped resolving (NXDOMAIN from both Cloudflare and Google resolvers, 2026-08-14)

