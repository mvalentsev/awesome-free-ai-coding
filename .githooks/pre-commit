#!/bin/sh
# Every check on what is staged, before the commit exists: freetier-check,
# freetier-render --check and the tests on a snapshot of the index, the logs,
# the fields only the scheduled run writes (src/freetier_radar/gate.py).
# Enabled once per clone: git config core.hooksPath .githooks
exec uv run --quiet --frozen freetier-gate pre-commit
